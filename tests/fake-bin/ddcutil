#!/usr/bin/env bash
echo "$*" >> "$FAKE_DDCUTIL_LOG"
case "$*" in
  "detect --terse")
    cat <<'OUT'
Display 1
   I2C bus:  /dev/i2c-4
   DRM_connector:           card1-DP-1
   Monitor:                 GSM:LG ULTRAGEAR:

Display 2
   I2C bus:  /dev/i2c-6
   DRM_connector:           card1-HDMI-A-1
   Monitor:                 IVM:PL2745Q:11667M1A01234

Invalid display
   I2C bus:  /dev/i2c-7
   DRM_connector:           card1-DP-2
   Monitor:                 XXX:Broken:
OUT
    ;;
  "--bus 4 getvcp 10 --brief") echo "VCP 10 C 70 100" ;;
  "--bus 6 getvcp 10 --brief") echo "VCP 10 C 20 50" ;;
  "--bus $FAKE_DDCUTIL_FAIL_BUS setvcp"*) echo "DDC communication failed" >&2; exit 1 ;;
  *"setvcp"*) ;;
  *) echo "unexpected: $*" >&2; exit 2 ;;
esac
